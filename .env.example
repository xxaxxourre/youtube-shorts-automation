# Google Gemini API Key (get from console.cloud.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Pexels API Key (get from pexels.com/api)
PEXELS_API_KEY=your_pexels_api_key_here

# YouTube credentials path (service account JSON)
# Create at console.cloud.google.com -> APIs & Services -> Credentials
YOUTUBE_CREDENTIALS_PATH=/path/to/youtube_credentials.json
